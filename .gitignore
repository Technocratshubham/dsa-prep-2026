# Ignore compiled output files and directories
# Ignore all files ending in .log
*.log
# Ignore all files ending in .tmp
*.tmp
# Ignore the build directory in the root folder
/build/
# Ignore the node_modules directory
/node_modules/
# Ignore the vendor directory (common for dependencies)
/vendor/

# OS-specific temporary files
# macOS temporary file
.DS_Store
# Windows temporary file
Thumbs.db

# IDE-specific files and directories
# VSCode directory (contains user-specific settings)
.vscode/
# IntelliJ IDE directory
.idea/

# Environment files (sensitive data)
# Environment variable files (can contain API keys/secrets)
.env

# Microsoft Office temporary files
~$*.docx
~$*.doc
*.iml
